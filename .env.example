# 환경 변수 (Git 커밋 금지 — cp .env.example .env)

API_URL=http://localhost:8000
API_BASE=http://localhost:8000

OPENAI_API_KEY=your_openai_api_key

# Docker / Cloudflare Containers
# CORS_ALLOW_ALL=1
# API_URL=http://127.0.0.1:8000
# 브라우저에서 쓰는 에셋 베이스 (Docker/nginx는 /assets)
# ASSET_PUBLIC_URL=/assets
# 로컬 Streamlit 단독: http://localhost:8000/assets

# 선택 — Langfuse
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Notion 리포트 업로드 (update_notion.py)
NOTION_TOKEN=ntn_your_integration_token_here
NOTION_PAGE_ID=your_32char_page_id_here
