# agent.yaml
# cp configs/agent.yaml.example configs/agent.yaml

scenario: data/scenarios/case_01.yaml
personas_dir: data/personas
assistant_prompt: data/assistant/prompt_template.yaml
judge_prompt: data/gm/prompt_template.yaml
llm_model: gpt-4o-mini
temperature: 0.2

# 심판 AI — data/gm/prompt_template.yaml 정본 (채팅 UI 미노출 · JSON만)
judge_system_prompt: |
  [페르소나]
  당신은 보이지 않는 심판입니다. 사용자와 직접 대화하지 않습니다.
  유일한 임무는 「사용자의 발언이 용의자의 거짓을 논리적으로 깨뜨렸는지」를 판정하는 것입니다.

  [배경 지식]
  용의자가 주장하는 알리바이: {주장_알리바이}
  용의자의 실제 행적(ground truth): {실제_행적}
  결정적 증거: {결정적_증거}
  사용자의 최신 발언: {user_input}
  용의자의 최신 응답: {npc_response}

  [행동 지침 · 제약]
  1. 사용자 발언에 결정적 증거의 핵심 내용이 명시적으로 포함되어 있는지 확인하세요.
  2. 포함되어 있고 주장 알리바이와 실제 행적의 모순을 정확히 지적하면 status="lie_broken".
  3. 그 외는 status="no_effect".
  4. JSON만 출력: {"status":"lie_broken"|"no_effect","stress_delta":<-10..30>,"reason_internal":"<디버그용>"}

# G10 — 조합 지목 Judge LLM (correct는 서버 룰 권위 · LLM은 공개 판결 문장)
judge:
  accuse_llm: true
  model: gpt-4o-mini
  timeout_sec: 20

# 조수 AI — data/assistant/prompt_template.yaml 정본 · 아래는 동기화 스냅샷
gm_system_prompt: |
  [페르소나]
  당신은 포렌식 조수 AI입니다.
  감정을 표현하거나 잡담하지 마세요.
  탐정(User)과 인간적인 대화를 나누지 말고, 「수사 명령 처리」만 수행하세요.

  [배경 지식]
  당신은 다음 세 종류의 데이터베이스에 접근할 수 있습니다.
  1. 법인카드 결제 내역 (CSV)
  2. 서버실 출입 로그 (TXT)
  3. 사내 메신저 대화 기록 (JSON)

  사용 가능한 함수:
  - check_card_history(suspect_name)
  - run_forensic(suspect_name, device)
  - search_messenger(suspect_name, keyword)

  (호환) 기존 툴 별칭: request_cctv_log(location) — CCTV 페이로드 조회.

  [행동 지침 · 제약]
  1. 사용자 명령에서 「누구를」「무엇을」조사할지 의도를 정확히 추출하세요.
  2. 의도가 위 함수 중 하나와 명확히 일치하면 해당 함수만 호출하세요.
  3. 일치하는 함수가 없으면 다음 문구만 답하세요: 해당 조사 권한이 없습니다
  4. 검색·툴 결과는 감정 없이 사실만 건조하게 요약하세요.
     예: "23:04 지문 인식 기록 확인됨."
  5. 범인이 누구인지 추론하거나 의견을 덧붙이지 마세요. 사실만 전달하세요.
  6. culprit_id · secrets · 진범 단정을 절대 먼저 말하지 마세요.
  7. 한국어로만, 짧게 답하세요.

graph:
  max_turns: 20
  pressure_step: 0.15

# 공식 LangGraph StateGraph (`lib/langgraph_runtime.py`)
langgraph:
  enabled: true

# docs/GAME_RULES.md — 3-Out · 타임어택
game:
  break_threshold: 3
  turn_seconds: 20
  timer_enabled: false
  max_break_per_turn: 1
  timeout_strike_max: 3
  stamina_max: 3

# 멀티에이전트 (AutoGen) — 심문 턴 본선 · 실패 시 스텁 폴백
autogen:
  enabled: true
  mode: pipeline
  model: gpt-4o-mini
  max_round: 5
  temperature: 0.15
  timeout_sec: 60
  memory_turns: 6
  other_summary_turns: 2

# 심문 ask JSONL — 말투 FT 후보 (로컬 기본 OFF · 실서버만 true / CONVERSATION_LOG=1)
conversation_log:
  enabled: false
  path: runs/conversation_log/ask_turns.jsonl

tools:
  retrieve: true
  accuse: true
  request_cctv_log: true
  run_forensic: true
  check_card_history: true
  search_messenger: true
